#!/bin/bash
# Scansione ClamAV (classe A). Uso: clamav-scan [target]   (default: /)
# - log completo datato:   /var/log/clamav-scan/scan-AAAA-MM-GG.log (root 0640, pulizia oltre 180 giorni)
#   NON nella home di mexage: root non deve scrivere/chown in una cartella controllata da un utente (symlink).
# - log eventi per Wazuh:  /var/log/clamav-scan/events.log, una riga per evento:
#     <ISO8601> <host> clamav-scan: FOUND file="<path>" signature="<sig>"
#     <ISO8601> <host> clamav-scan: SCAN_DONE target="<path>" infected=<n> scanned=<n> sigs="<versione>" rc=<n>
#     <ISO8601> <host> clamav-scan: ERROR rc=<n>
# Exit code = quello di clamscan (0 pulito, 1 malware trovato, 2 errore).
set -u
TARGET="${1:-/}"
EVENTS=/var/log/clamav-scan/events.log
LOGDIR=/var/log/clamav-scan
LOG="$LOGDIR/scan-$(date +%F).log"
OUT=$(mktemp)
trap 'rm -f "$OUT"' EXIT

umask 027
install -d -m 0750 -o root -g root "$LOGDIR"
ev() { printf '%s %s clamav-scan: %s\n' "$(date -Iseconds)" "$(hostname -s)" "$1" >> "$EVENTS"; }
# campi dentro gli eventi: via i caratteri di controllo (un a-capo nel nome di un file non deve poter
# creare una riga/evento falso per Wazuh), poi \ e " sostituiti da / e '
q() { printf '%s' "$1" | tr -d '[:cntrl:]' | tr '\\"' "/'"; }

SIGS=$(clamscan --version 2>/dev/null || echo unknown)
# stdout = solo righe "... FOUND" (-i), righe vuote e riepilogo; lo stderr (avvisi LibClamAV) va nel log completo
clamscan -r -i --exclude-dir='^/(proc|sys|dev|run)(/|$)' --log="$LOG" "$TARGET" > "$OUT" 2>> "$LOG"
rc=$?

# L'output testuale di clamscan è ambiguo: un nome di file può contenere a-capo e quindi FALSIFICARE righe
# (un finto "… FOUND" in più = falso allarme con firma inventata; un finto "----------- SCAN SUMMARY" =
# rilevamenti nascosti). Le righe FOUND si credono SOLO se l'output è coerente con fatti indipendenti:
# - il riepilogo vero è l'ULTIMO marcatore (riconosciuto per posizione, non per contenuto);
# - prima del riepilogo ci sono solo righe "… FOUND" o vuote;
# - il numero di righe FOUND è UGUALE a "Infected files" (né di più: falsi allarmi; né di meno: nascosti);
# - rc coerente (1 se ci sono infetti, 0 se non ce ne sono).
# Altrimenti un solo evento "output non coerente": resta un allarme (qualcuno ha costruito apposta un nome
# di file, o clamscan si è comportato in modo inatteso) e il dettaglio vero è nel log completo.
last=$(grep -n '^----------- SCAN SUMMARY' "$OUT" | tail -1 | cut -d: -f1)
BODY=$(mktemp); trap 'rm -f "$OUT" "$BODY"' EXIT
if [ -n "$last" ]; then head -n "$((last - 1))" "$OUT" > "$BODY"; else cp "$OUT" "$BODY"; fi
infected=$(sed -n 's/^Infected files: \([0-9]*\).*/\1/p' "$OUT" | tail -1)

stray=0; found=0
while IFS= read -r l; do
  case "$l" in
    "") ;;
    *" FOUND") found=$((found + 1)) ;;
    *) stray=1 ;;
  esac
done < "$BODY"

consistent=1
[ -n "$last" ] && [ -n "$infected" ] || consistent=0
[ "$stray" -eq 0 ] || consistent=0
[ "$found" -eq "${infected:-0}" ] || consistent=0
if [ "$found" -gt 0 ]; then [ "$rc" -eq 1 ] || consistent=0; fi

if [ "$consistent" -eq 1 ]; then
  while IFS= read -r l; do
    case "$l" in
      *" FOUND")
        body="${l% FOUND}"
        file="${body%: *}"
        [ -e "$file" ] || file="(percorso non affidabile, vedi $LOG)"
        ev "FOUND file=\"$(q "$file")\" signature=\"$(q "${body##*: }")\"" ;;
    esac
  done < "$BODY"
elif [ "$found" -gt 0 ] || [ "${infected:-0}" -gt 0 ] || [ "$rc" -eq 1 ]; then
  ev "FOUND file=\"(output di clamscan non coerente: righe FOUND $found, infetti ${infected:-?}, rc $rc; vedi $LOG)\" signature=\"output-anomaly\""
fi
scanned=$(sed -n 's/^Scanned files: \([0-9]*\).*/\1/p' "$OUT" | tail -1)
[ "$rc" -ge 2 ] && ev "ERROR rc=$rc"
ev "SCAN_DONE target=\"$(q "$TARGET")\" infected=${infected:-0} scanned=${scanned:-0} sigs=\"$(q "$SIGS")\" rc=$rc"

find "$LOGDIR" -name 'scan-*.log' -mtime +180 -delete 2>/dev/null
exit "$rc"
